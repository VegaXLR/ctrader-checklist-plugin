{
  "name": "@spotware-web-team/sdk-external-api",
  "version": "0.0.6",
  "author": "Spotware",
  "license": "ISC",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "update": "ts-node update.ts && yarn install",
    "compile": "tsc --noEmit",
    "build": "shx rm -rf dist && tsup",
    "push": "yarn build && yarn version patch && npm publish --access public"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/node": "22.13.10",
    "@veksa/logger": "^1.0.6",
    "fs-extra": "11.3.0",
    "rxjs": "7.8.2",
    "shx": "0.4.0",
    "ts-node": "10.9.2",
    "tsup": "8.4.0",
    "typescript": "5.8.2",
    "uuid": "11.1.0"
  },
  "peerDependencies": {
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  }
}
